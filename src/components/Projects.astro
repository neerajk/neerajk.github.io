---
import { projects, achievements } from '../data/cv';
import Glyph from './Glyph.astro';
---

<section id="projects">
  <div class="wrap">
    <div class="section-head">
      <span class="idx">03</span>
      <h2>Projects</h2>
      <span class="rule"></span>
      <span class="note">{projects.length} scenes</span>
    </div>

    <div class="grid">
      {
        projects.map((p, i) => {
          const Tag = p.url ? 'a' : 'article';
          return (
            <Tag class="card reveal" href={p.url} style={`--d:${i * 80}ms`}>
              <Glyph kind={p.glyph} />
              <div class="body">
                <dl class="meta mono">
                  <div><dt>Sensor</dt><dd>{p.sensor}</dd></div>
                  <div><dt>GSD</dt><dd>{p.gsd}</dd></div>
                  <div><dt>Task</dt><dd>{p.task}</dd></div>
                </dl>
                <h3>
                  {p.name}
                  {p.url && <span class="arrow" aria-hidden="true">↗</span>}
                </h3>
                <p>{p.text}</p>
              </div>
            </Tag>
          );
        })
      }
    </div>

    {
      achievements.map((a) => (
        <aside class="award reveal">
          <span class="mono badge">★ {a.when}</span>
          <div>
            <h3>{a.title}</h3>
            <p class="muted org">{a.org}</p>
            <p>{a.text}</p>
          </div>
        </aside>
      ))
    }
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 20px;
  }

  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.25s ease, transform 0.25s ease, opacity 0.7s ease;
    transition-delay: 0s, 0s, var(--d);
  }

  a.card:hover,
  .card:hover {
    border-color: var(--accent);
    color: inherit;
    transform: translateY(-3px);
  }

  .body {
    padding: 18px 18px 22px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin: 0 0 14px;
    font-size: 0.68rem;
  }

  .meta div {
    display: flex;
    gap: 6px;
  }

  .meta dt {
    color: var(--muted);
  }

  .meta dd {
    margin: 0;
    color: var(--accent);
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.55rem;
    line-height: 1.15;
  }

  .arrow {
    color: var(--accent);
    font-family: var(--font-body);
    font-size: 1rem;
    margin-left: 6px;
  }

  p {
    margin: 10px 0 0;
    font-size: 0.95rem;
  }

  .award {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 24px;
    margin-top: 40px;
    padding: 28px;
    border: 1px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 7%, var(--bg));
  }

  .badge {
    color: var(--accent);
  }

  .award h3 {
    font-size: 2rem;
  }

  .award .org {
    margin-top: 2px;
  }

  @media (max-width: 720px) {
    .award {
      grid-template-columns: 1fr;
      gap: 10px;
      padding: 20px;
    }
  }
</style>
