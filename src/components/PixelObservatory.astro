---
// Pixel Observatory: real Sentinel-2 / Sentinel-1 / Landsat / ESA WorldCover tiles for three AOIs,
// with a time slider (same season, several years) and a live pixel readout.
// Tiles are generated by tools/make_aoi_tiles.py into public/aoi/ and src/data/aois.json.
import aois from '../data/aois.json';

const n = aois[0]?.n ?? 320;
const layers = [
  { id: 'true', label: 'True colour' },
  { id: 'false', label: 'False colour' },
  { id: 'ndvi', label: 'NDVI' },
  { id: 'dndvi', label: 'ΔNDVI' },
  { id: 'lc', label: 'Land cover' },
  { id: 'vv', label: 'SAR VV' },
  { id: 'lst', label: 'LST' },
];
---

<figure class="obs" data-aois={JSON.stringify(aois)} data-base={import.meta.env.BASE_URL}>
  <div class="tabs places" aria-label="Area of interest">
    {aois.map((a, i) => <button type="button" data-aoi={a.slug} aria-pressed={i === 0 ? 'true' : 'false'}>{a.name}</button>)}
  </div>

  <div class="frame">
    <div class="stage" style={`--n:${n};--x:${n >> 1};--y:${n >> 1}`}>
      <canvas class="main" width={n} height={n} tabindex="0" aria-label="Satellite tile. Move the pointer or use arrow keys to inspect pixels."></canvas>
      <div class="scanline" aria-hidden="true"></div>
      <div class="xh h" aria-hidden="true"></div>
      <div class="xh v" aria-hidden="true"></div>
      <div class="pxbox" aria-hidden="true"></div>
      {aois.length === 0 && <p class="empty mono">Run tools/make_aoi_tiles.py to generate tiles</p>}
    </div>
    <span class="tick tl" aria-hidden="true"></span>
    <span class="tick tr" aria-hidden="true"></span>
    <span class="tick bl" aria-hidden="true"></span>
    <span class="tick br" aria-hidden="true"></span>
  </div>

  <div class="time">
    <button type="button" class="play mono" aria-label="Play time series">▶</button>
    <div class="slider">
      <input type="range" min="0" max="0" step="1" value="0" aria-label="Acquisition date" />
      <div class="marks mono" aria-hidden="true"></div>
    </div>
  </div>

  <div class="tabs layers" aria-label="Layer">
    {layers.map((l) => <button type="button" data-layer={l.id}>{l.label}</button>)}
  </div>

  <div class="legend mono" aria-hidden="true"></div>

  <dl class="readout mono" aria-live="polite">
    <div data-k="date"><dt>Date</dt><dd>—</dd></div>
    <div data-k="px"><dt>Pixel</dt><dd>—</dd></div>
    <div data-k="ll"><dt>Lat / Lon</dt><dd>—</dd></div>
    <div data-k="lc"><dt>Class</dt><dd>—</dd></div>
    <div data-k="ndvi"><dt>NDVI</dt><dd>—</dd></div>
    <div data-k="dndvi"><dt>ΔNDVI</dt><dd>—</dd></div>
    <div data-k="vv"><dt>VV</dt><dd>—</dd></div>
    <div data-k="lst"><dt>LST</dt><dd>—</dd></div>
  </dl>

  <figcaption class="mono src"></figcaption>
</figure>

<script>
  type LL = [number, number];
  type Epoch = {
    key: string;
    s2: { date: string; id: string };
    s1: { date: string } | null;
    lst: { date: string; platform: string } | null;
  };
  type Meta = {
    slug: string;
    name: string;
    n: number;
    epsg: number;
    corners: { nw: LL; ne: LL; sw: LL; se: LL };
    lst_range: [number, number] | null;
    epochs: Epoch[];
  };
  type Data = { vis: Uint8ClampedArray; dat: Uint8ClampedArray; dat2: Uint8ClampedArray; epoch: Epoch };
  type RGB = [number, number, number];

  const WORLDCOVER: Record<number, [string, string]> = {
    10: ['Tree cover', '#006400'],
    20: ['Shrubland', '#ffbb22'],
    30: ['Grassland', '#ffff4c'],
    40: ['Cropland', '#f096ff'],
    50: ['Built-up', '#fa0000'],
    60: ['Bare / sparse', '#b4b4b4'],
    70: ['Snow & ice', '#f0f0f0'],
    80: ['Water', '#0064c8'],
    90: ['Herbaceous wetland', '#0096a0'],
    95: ['Mangroves', '#00cf75'],
    100: ['Moss & lichen', '#fae6a0'],
  };
  const NDVI_RAMP = ['#8c510a', '#d8b365', '#f6e8c3', '#a6d96a', '#1a9641', '#00441b'];
  const DNDVI_RAMP = ['#b2182b', '#ef8a62', '#f7f7f7', '#a6d96a', '#1a9641'];
  const INFERNO = ['#000004', '#280b54', '#65156e', '#9f2a63', '#d44842', '#f57d15', '#fac127', '#fcffa4'];
  const BAND_TO_LAYER: Record<string, string> = { rgb: 'true', nir: 'false', sar: 'vv', tir: 'lst', pan: 'true' };
  const NODATA: RGB = [38, 38, 38];
  const DN_RANGE = 0.4; // ΔNDVI colour scale is ±0.4

  const hex = (h: string): RGB => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16)) as RGB;
  const LC_RGB: Record<number, RGB> = Object.fromEntries(Object.entries(WORLDCOVER).map(([k, v]) => [k, hex(v[1])]));
  function ramp(stops: string[], t: number): RGB {
    const p = Math.min(0.999, Math.max(0, t)) * (stops.length - 1);
    const k = Math.floor(p);
    const a = hex(stops[k]), b = hex(stops[k + 1]);
    return [0, 1, 2].map((i) => a[i] + (b[i] - a[i]) * (p - k)) as RGB;
  }

  const fig = document.querySelector<HTMLElement>('.obs')!;
  const metas: Meta[] = JSON.parse(fig.dataset.aois || '[]');
  const base = (fig.dataset.base || '/').replace(/\/$/, '');

  if (metas.length && metas[0].epochs?.length) {
    const N = metas[0].n;
    const q = <T extends Element>(s: string) => fig.querySelector<T>(s)!;
    const mainCv = q<HTMLCanvasElement>('canvas.main');
    const mainCtx = mainCv.getContext('2d')!;
    const mainImg = mainCtx.createImageData(N, N);
    const stage = q<HTMLElement>('.stage');
    const line = q<HTMLElement>('.scanline');
    const range = q<HTMLInputElement>('.slider input');
    const marks = q<HTMLElement>('.marks');
    const playBtn = q<HTMLButtonElement>('.play');
    const legend = q<HTMLElement>('.legend');
    const src = q<HTMLElement>('.src');
    const rows = Object.fromEntries(
      [...fig.querySelectorAll<HTMLElement>('.readout [data-k]')].map((el) => [el.dataset.k!, el]),
    );
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cache = new Map<string, Promise<Data>>();

    let meta = metas[0];
    let epochIdx = meta.epochs.length - 1;
    let layer = BAND_TO_LAYER[document.documentElement.dataset.band || 'rgb'] || 'true';
    let cur: Data | null = null;
    let ref: Data | null = null;
    let cx = N >> 1, cy = N >> 1;
    let job = 0;
    let timer = 0;

    // ---------- data ----------
    async function pixels(url: string): Promise<Uint8ClampedArray> {
      const res = await fetch(url);
      const bmp = await createImageBitmap(await res.blob(), { colorSpaceConversion: 'none', premultiplyAlpha: 'none' });
      const c = document.createElement('canvas');
      c.width = bmp.width;
      c.height = bmp.height;
      const g = c.getContext('2d', { willReadFrequently: true })!;
      g.drawImage(bmp, 0, 0);
      return g.getImageData(0, 0, bmp.width, bmp.height).data;
    }

    function get(m: Meta, i: number): Promise<Data> {
      const e = m.epochs[i];
      const key = `${m.slug}/${e.key}`;
      if (!cache.has(key)) {
        const dir = `${base}/aoi/${key}`;
        cache.set(
          key,
          Promise.all(['vis', 'dat', 'dat2'].map((f) => pixels(`${dir}/${f}.png`))).then(([vis, dat, dat2]) => ({
            vis,
            dat,
            dat2,
            epoch: e,
          })),
        );
      }
      return cache.get(key)!;
    }

    // Decoders for the PNG encodings written by tools/make_aoi_tiles.py.
    const ndviAt = (d: Data, i: number) => d.dat[i * 4 + 1] / 127.5 - 1;
    const vvAt = (d: Data, i: number) => (d.dat2[i * 4] / 255) * 35 - 30;
    const lstAt = (d: Data, i: number) => (d.dat2[i * 4 + 1] / 255) * 70 - 10;
    const flagsAt = (d: Data, i: number) => d.dat2[i * 4 + 2];
    const clsAt = (d: Data, i: number) => d.dat[i * 4 + 2];
    const dndviAt = (d: Data, r: Data, i: number) =>
      flagsAt(d, i) & 1 && flagsAt(r, i) & 1 ? ndviAt(d, i) - ndviAt(r, i) : null;
    const month = (e: Epoch) => e.s2.date.slice(0, 7);

    // ---------- drawing ----------
    function colour(d: Data, lyr: string, i: number): RGB {
      const f = flagsAt(d, i);
      const o = i * 4;
      switch (lyr) {
        case 'false':
          return [d.dat[o], d.vis[o], d.vis[o + 1]];
        case 'ndvi':
          return f & 1 ? ramp(NDVI_RAMP, (ndviAt(d, i) + 0.2) / 1.1) : NODATA;
        case 'dndvi': {
          const v = ref ? dndviAt(d, ref, i) : null;
          return v === null ? NODATA : ramp(DNDVI_RAMP, (v + DN_RANGE) / (2 * DN_RANGE));
        }
        case 'lc':
          return LC_RGB[clsAt(d, i)] ?? NODATA;
        case 'vv': {
          if (!(f & 2)) return NODATA;
          const g = Math.min(255, Math.max(0, ((vvAt(d, i) + 25) / 25) * 255));
          return [g, g, g];
        }
        case 'lst': {
          if (!(f & 4) || !meta.lst_range) return NODATA;
          const [lo, hi] = meta.lst_range;
          return ramp(INFERNO, (lstAt(d, i) - lo) / (hi - lo));
        }
        default:
          return [d.vis[o], d.vis[o + 1], d.vis[o + 2]];
      }
    }

    function fill(img: ImageData, d: Data, lyr: string, from: number, to: number) {
      for (let i = from * N; i < to * N; i++) {
        const [r, g, b] = colour(d, lyr, i);
        img.data[i * 4] = r;
        img.data[i * 4 + 1] = g;
        img.data[i * 4 + 2] = b;
        img.data[i * 4 + 3] = 255;
      }
    }

    // Re-acquire the tile with a pushbroom sweep.
    function renderMain(animate: boolean) {
      if (!cur) return;
      const d = cur;
      const id = ++job;
      if (reduced || !animate) {
        fill(mainImg, d, layer, 0, N);
        mainCtx.putImageData(mainImg, 0, 0);
        return;
      }
      let row = 0;
      line.style.opacity = '1';
      const step = () => {
        if (id !== job) return;
        const next = Math.min(N, row + 10);
        fill(mainImg, d, layer, row, next);
        mainCtx.putImageData(mainImg, 0, 0);
        row = next;
        line.style.setProperty('--p', String(row / N));
        if (row < N) requestAnimationFrame(step);
        else line.style.opacity = '0';
      };
      requestAnimationFrame(step);
    }

    // ---------- readout ----------
    function lonLat(x: number, y: number): LL {
      const { nw, ne, sw, se } = meta.corners;
      const u = (x + 0.5) / N, v = (y + 0.5) / N;
      const top = [nw[0] + (ne[0] - nw[0]) * u, nw[1] + (ne[1] - nw[1]) * u];
      const bot = [sw[0] + (se[0] - sw[0]) * u, sw[1] + (se[1] - sw[1]) * u];
      return [top[0] + (bot[0] - top[0]) * v, top[1] + (bot[1] - top[1]) * v];
    }

    const set = (k: string, v: string) => (rows[k].querySelector('dd')!.textContent = v);

    function inspect(x: number, y: number) {
      cx = Math.max(0, Math.min(N - 1, x));
      cy = Math.max(0, Math.min(N - 1, y));
      stage.style.setProperty('--x', String(cx));
      stage.style.setProperty('--y', String(cy));
      const d = cur;
      if (!d) return;
      const i = cy * N + cx;
      const f = flagsAt(d, i);
      const [lon, lat] = lonLat(cx, cy);
      const cls = WORLDCOVER[clsAt(d, i)];
      const dn = ref ? dndviAt(d, ref, i) : null;
      set('date', d.epoch.s2.date);
      set('px', `${String(cx).padStart(3, '0')}, ${String(cy).padStart(3, '0')}`);
      set('ll', `${Math.abs(lat).toFixed(4)}°${lat >= 0 ? 'N' : 'S'} ${Math.abs(lon).toFixed(4)}°${lon >= 0 ? 'E' : 'W'}`);
      set('lc', cls ? cls[0] : '—');
      set('ndvi', f & 1 ? ndviAt(d, i).toFixed(2) : 'cloud');
      set('dndvi', dn === null ? '—' : `${dn >= 0 ? '+' : '−'}${Math.abs(dn).toFixed(2)}`);
      set('vv', f & 2 ? `${vvAt(d, i).toFixed(1)} dB` : 'no data');
      set('lst', f & 4 ? `${lstAt(d, i).toFixed(1)} °C` : 'no data');
    }

    // ---------- chrome: legend, caption, slider ----------
    function drawLegend() {
      Object.entries(rows).forEach(([k, el]) => el.classList.toggle('on', k === layer));
      const grad = (stops: string[], lo: string, hi: string, unit = '') =>
        `<span>${lo}</span><i style="background:linear-gradient(90deg,${stops.join(',')})"></i><span>${hi}${unit}</span>`;
      const first = meta.epochs[0];
      if (layer === 'true') legend.innerHTML = '<span>Sentinel-2 · B4 B3 B2</span>';
      else if (layer === 'false') legend.innerHTML = '<span>Sentinel-2 · B8 B4 B3 · vegetation shows red</span>';
      else if (layer === 'ndvi') legend.innerHTML = grad(NDVI_RAMP, '−0.2', '0.9');
      else if (layer === 'dndvi')
        legend.innerHTML = grad(DNDVI_RAMP, `−${DN_RANGE}`, `+${DN_RANGE}`) + `<span>change since ${month(first)}</span>`;
      else if (layer === 'vv') legend.innerHTML = grad(['#000', '#fff'], '−25', '0', ' dB');
      else if (layer === 'lst')
        legend.innerHTML = meta.lst_range
          ? grad(INFERNO, meta.lst_range[0].toFixed(0), meta.lst_range[1].toFixed(0), ' °C')
          : '<span>No thermal scene for this area</span>';
      else {
        const seen = new Set<number>();
        if (cur) for (let i = 0; i < N * N; i++) seen.add(clsAt(cur, i));
        legend.innerHTML = [...seen]
          .filter((c) => c in WORLDCOVER)
          .sort((a, b) => a - b)
          .map((c) => `<span class="sw"><b style="background:${WORLDCOVER[c][1]}"></b>${WORLDCOVER[c][0]}</span>`)
          .join('');
      }
    }

    function caption() {
      const e = meta.epochs[epochIdx];
      const parts = [`Sentinel-2 L2A ${e.s2.date}`];
      if (e.s1) parts.push(`Sentinel-1 RTC ${e.s1.date}`);
      if (e.lst) parts.push(`${e.lst.platform.replace('landsat-', 'Landsat ')} ${e.lst.date}`);
      parts.push('© ESA WorldCover 2021 (CC BY 4.0)', `EPSG:${meta.epsg}`);
      src.textContent = parts.join(' · ');
    }

    function buildControls() {
      const k = meta.epochs.length;
      range.max = String(k - 1);
      range.value = String(epochIdx);
      range.disabled = k < 2;
      playBtn.disabled = k < 2;
      marks.innerHTML = meta.epochs.map((e) => `<span>${month(e)}</span>`).join('');
      q<HTMLElement>('[data-layer="dndvi"]').hidden = k < 2;
      if (k < 2 && layer === 'dndvi') layer = 'ndvi';
    }

    // ---------- state changes ----------
    async function refresh(animate = true) {
      const m = meta, i = epochIdx;
      const [d, r] = await Promise.all([get(m, i), get(m, 0)]);
      if (m !== meta || i !== epochIdx) return; // superseded
      cur = d;
      ref = r;
      caption();
      drawLegend();
      renderMain(animate);
      inspect(cx, cy);
      m.epochs.forEach((_, j) => get(m, j)); // prefetch the rest of the series
    }

    function setLayer(id: string) {
      layer = id;
      fig.querySelectorAll<HTMLButtonElement>('[data-layer]').forEach((b) =>
        b.setAttribute('aria-pressed', String(b.dataset.layer === id)),
      );
      drawLegend();
      renderMain(true);
    }

    function setEpoch(i: number) {
      epochIdx = i;
      range.value = String(i);
      refresh();
    }

    function setAoi(slug: string) {
      stop();
      meta = metas.find((m) => m.slug === slug) ?? metas[0];
      epochIdx = meta.epochs.length - 1;
      cur = ref = null; // don't paint the previous place with this place's settings
      fig.querySelectorAll<HTMLButtonElement>('[data-aoi]').forEach((b) =>
        b.setAttribute('aria-pressed', String(b.dataset.aoi === meta.slug)),
      );
      buildControls();
      setLayer(layer);
      refresh();
    }

    function stop() {
      clearInterval(timer);
      timer = 0;
      playBtn.textContent = '▶';
      playBtn.setAttribute('aria-label', 'Play time series');
    }

    function play() {
      if (timer) return stop();
      playBtn.textContent = '❚❚';
      playBtn.setAttribute('aria-label', 'Pause time series');
      const advance = () => setEpoch((epochIdx + 1) % meta.epochs.length);
      advance();
      timer = window.setInterval(advance, 1600);
    }

    // ---------- events ----------
    const pick = (e: PointerEvent) => {
      const r = mainCv.getBoundingClientRect();
      inspect(Math.floor(((e.clientX - r.left) / r.width) * N), Math.floor(((e.clientY - r.top) / r.height) * N));
    };
    mainCv.addEventListener('pointermove', pick);
    mainCv.addEventListener('pointerdown', pick);
    mainCv.addEventListener('keydown', (e) => {
      const s = e.shiftKey ? 10 : 1;
      const mv = ({ ArrowLeft: [-s, 0], ArrowRight: [s, 0], ArrowUp: [0, -s], ArrowDown: [0, s] } as Record<string, number[]>)[e.key];
      if (!mv) return;
      e.preventDefault();
      inspect(cx + mv[0], cy + mv[1]);
    });

    range.addEventListener('input', () => {
      stop();
      setEpoch(Number(range.value));
    });
    playBtn.addEventListener('click', play);
    fig.querySelectorAll<HTMLButtonElement>('[data-aoi]').forEach((b) => b.addEventListener('click', () => setAoi(b.dataset.aoi!)));
    fig.querySelectorAll<HTMLButtonElement>('[data-layer]').forEach((b) => b.addEventListener('click', () => setLayer(b.dataset.layer!)));
    window.addEventListener('bandchange', (e) => setLayer(BAND_TO_LAYER[(e as CustomEvent<string>).detail] || 'true'));

    setAoi(meta.slug);
  }
</script>

<style>
  .obs {
    margin: 0;
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tabs button,
  .play {
    padding: 5px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font: 500 0.72rem/1.4 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }

  .tabs button:hover,
  .play:hover {
    border-color: var(--accent);
    color: var(--ink);
  }

  .tabs button[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }

  button:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .places {
    margin-bottom: 12px;
  }

  .layers {
    margin-top: 12px;
  }

  .frame {
    position: relative;
    padding: 10px;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .stage {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    touch-action: pan-y;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }

  canvas.main {
    cursor: crosshair;
  }

  canvas.main:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Crosshair and pixel box follow --x / --y (pixel indices). */
  .xh {
    position: absolute;
    pointer-events: none;
    background: color-mix(in srgb, var(--ink) 70%, transparent);
    mix-blend-mode: difference;
  }

  .xh.h {
    left: 0;
    right: 0;
    height: 1px;
    top: calc((var(--y) + 0.5) / var(--n) * 100%);
  }

  .xh.v {
    top: 0;
    bottom: 0;
    width: 1px;
    left: calc((var(--x) + 0.5) / var(--n) * 100%);
  }

  .pxbox {
    position: absolute;
    pointer-events: none;
    left: calc((var(--x) + 0.5) / var(--n) * 100%);
    top: calc((var(--y) + 0.5) / var(--n) * 100%);
    width: max(7px, calc(100% / var(--n)));
    height: max(7px, calc(100% / var(--n)));
    outline: 2px solid var(--accent);
    transform: translate(-50%, -50%);
  }

  .scanline {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--p, 0) * 100%);
    height: 2px;
    background: var(--accent);
    box-shadow: 0 0 14px 2px var(--accent);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .empty {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    padding: 24px;
    text-align: center;
    color: var(--muted);
  }

  .tick {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 0 solid var(--accent);
  }

  .tl { top: -1px; left: -1px; border-top-width: 2px; border-left-width: 2px; }
  .tr { top: -1px; right: -1px; border-top-width: 2px; border-right-width: 2px; }
  .bl { bottom: -1px; left: -1px; border-bottom-width: 2px; border-left-width: 2px; }
  .br { bottom: -1px; right: -1px; border-bottom-width: 2px; border-right-width: 2px; }

  /* Time slider */
  .time {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-top: 14px;
  }

  .play {
    flex: none;
    width: 40px;
    padding: 5px 0;
  }

  .slider {
    flex: 1;
  }

  input[type='range'] {
    width: 100%;
    margin: 6px 0 0;
    accent-color: var(--accent);
  }

  .marks {
    display: flex;
    justify-content: space-between;
    color: var(--muted);
    font-size: 0.62rem;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    min-height: 22px;
    margin-top: 12px;
    color: var(--muted);
    font-size: 0.68rem;
  }

